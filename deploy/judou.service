# 句读 JUDOU · systemd 服务（阿里云 ECS）
# 放到 /etc/systemd/system/judou.service，然后：
#   sudo systemctl daemon-reload && sudo systemctl enable --now judou

[Unit]
Description=Judou (Next.js)
After=network.target

[Service]
Type=simple
User=judou
WorkingDirectory=/opt/judou
EnvironmentFile=/opt/judou/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /opt/judou/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
