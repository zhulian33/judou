# OpenAI 兼容接口。填入后重启 npm run dev 即可启用真实 AI 解读。
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 不填 OPENAI_API_KEY 时，默认使用公共模型（有频率限制）。
PUBLIC_MODEL_URL=https://text.pollinations.ai/openai
PUBLIC_MODEL_NAME=openai

# 聊天截图 OCR。默认使用 OCR.space 的测试 Key，正式使用建议换成自己的免费 Key。
OCR_SPACE_API_KEY=helloworld
